{
  "$comment": "Beispiel – nach connection.json (und headers.example.json nach headers.json) kopieren und anpassen. Passwörter gehören NICHT hier hinein, sondern in die KeePass-Datenbank.",
  "listen": {
    "host": "127.0.0.1",
    "port": 8075,
    "mcpPort": 8076
  },
  "keepass": {
    "database": "./zugangsdaten.kdbx",
    "keyFile": null
  },
  "upstream": {
    "timeoutMs": 30000
  },
  "mcp": true,
  "headersFile": "./headers.json",
  "environments": {
    "dev": {
      "kunden": {
        "url": "https://kunden.dev.example.com/api",
        "tls": {
          "$comment": "Standard (kann entfallen): Zertifikat und Hostname werden geprüft. Private CA: \"caFile\": \"./certs/firmen-ca.pem\" – siehe README, Abschnitt TLS.",
          "rejectUnauthorized": true
        },
        "auth": {
          "username": "svc-kunden-dev",
          "entry": {
            "group": "dev/Services",
            "title": "kunden"
          }
        }
      },
      "bestellungen": {
        "url": "https://bestellungen.dev.example.com/api",
